KAKAO_REST_API_KEY=
TAGO_SERVICE_KEY=
PUBLIC_DATA_SERVICE_KEY=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
VWORLD_API_KEY=
OPINET_API_KEY=
DEMO_MODE=true

# 유해시설 지도 참고 표시 반경(m). 판정창(임계+버퍼) 밖이지만 이 반경 이내인
# 시설을 지도에 회색 참고 핀으로만 얹는다. 판정 결과(status·거리·심사표·CSV)에는
# 영향이 없다. 미지정 시 1000m.
HAZARD_CONTEXT_RADIUS_M=1000
ALLOWED_ORIGINS=http://localhost,http://localhost:5180,http://127.0.0.1:5180
CACHE_TTL_SECONDS=600

# --- 로컬 원천 경로 (제출본·오프라인 판정용) ---------------------------
# 비워 두면 해당 판정이 조용히 빠진다. 값이 없으면 dataset_missing 이 되어
# 오판정은 나지 않지만, 확정 가능한 항목이 줄어든다.

# 법정동코드표. 없으면 PNU 조립이 전건 실패해 공장 다목 판정이 죽는다.
#   예) delivery/metadata/legal_dong_codes.xlsx
LH_LEGAL_DONG_PATH=

# 박진주 대표님 표준 데이터셋(정본)과 원본 묶음.
#   예) delivery/standardized/facilities.xlsx / 전북시설원본.zip
LH_LOCAL_STANDARD_PATH=
LH_LOCAL_RAW_PATH=

# 전북 연속지적도 색인. 없으면 사업지·시설 경계가 임시 폴리곤으로 떨어진다.
#   backend/data/cadastral_jeonbuk.sqlite (build_index 로 생성, 약 8분)
#   생성 후 add_spatial_rtree_index 로 R-Tree 를 추가해야 조회가 빠르다.
CADASTRAL_JEONBUK_SHP=
CADASTRAL_JEONBUK_DB=

# 소음진동배출시설 CSV. API 미승인 상태의 보조 원천.
NOISE_EMISSION_CSV_PATH=

# 생활안전지도 인증키 (주유소·LPG충전소). safemap.go.kr 발급.
SAFEMAP_API_KEY=
